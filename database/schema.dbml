// Views
Table statistics {
  groups_count integer
  students_count integer
  teachers_count integer
  active_students_count integer
  inactive_students_count integer
}

Table group_stats {
  group_id bigint [ref: > groups.id]
  students_count integer
  commited_count integer
  uncommited_count integer
  absent_count integer
  inactive_count integer
}